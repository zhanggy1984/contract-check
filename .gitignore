# 本地配置（含 API key），禁止提交
**/.env
.env
# .env 的派生名（.env.c1bak / .env.bak / .env.old 等）同样是明文凭据，整类挡掉。
# 用通配而非逐个枚举文件名：本案的 `.env.c1bak` 就是 cp -r 派生出来的，
# 枚举法会一直漏。模板必须显式放行（backend/.env.example 是已跟踪文件）。
.env.*
!.env.example
# 本机端口覆盖（8088/8003），随本机环境不入库
docker-compose.override.yml

# Python
__pycache__/
*.pyc
.venv/
venv/

# 上传文件 / OCR 临时文件
uploads/
tmp/
# data/ 只入库演示脚本与说明；PDF 由 data/gen_demo_contracts.py 本地生成（体积大不入库）
data/parsed/
data/**/*.pdf
data/**/*.docx
data/**/*.png
# MySQL 备份产物（含合同数据，仅本机留存，禁止入库）
data/backups/
# 评测运行结果（verify_cc_* 产物，可重跑生成不入库）
data/test-contracts/cc_*_results.json
# backend 运行产生的数据目录（测试合同、解析产物、报告截图等，均不入库）
backend/data/

# 前端
node_modules/
dist/

# 部署启停脚本（本机一键脚本，无需提交）
start.ps1
start.sh
stop.ps1

# Claude Code 本地配置（skill 等，个人环境不入库）
.claude/

# codegraph 本地代码索引（工具产物，不入库）
.codegraph/
