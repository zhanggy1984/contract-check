# 复制为 .env 后填写真实值
# DeepSeek（必填）。注意：合同抽取/语义校验的文本内容会发送到 BASE_URL 指向的 LLM（数据出域），
# 默认公有云 DeepSeek；敏感合同建议改为内网/自建 LLM 端点。启动时自动检测端点，外网地址会 WARN。
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# MySQL（本机 dev 直接运行用；容器部署由 docker-compose 顶层 .env 注入，见 M3）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=contract_check
MYSQL_USER=contract
MYSQL_PASSWORD=contract123

# 认证（单用户 JWT 登录）。本机 dev 可设 AUTH_ENABLED=false 跳过登录；
# 生产必须设置 AUTH_PASSWORD（登录口令）+ JWT_SECRET（任意长随机串，HS256 签名密钥）。
# 留空时登录/受保护接口 503 fail-closed（不裸奔放行）。
# AUTH_ENABLED=true
# AUTH_USERNAME=admin
# AUTH_PASSWORD=change-me
# JWT_SECRET=change-me-to-a-long-random-string

# 任务并发上限（同时运行的校验流水线数，防连传大量合同 → 大量 LLM 并发）；超限排队不拒绝
# MAX_CONCURRENT_TASKS=3

# 观测上报 obs_sdk（§11.3 cc 接入；观测边带，缺任一项 = 完全关闭，业务零侵入）：
# 三项（OBS_ENABLED / 地址 / 主题）齐备才上报。主题格式 {env}.obs.agent.contract-check
# （env 与共享 Kafka 环境一致，如 dev/qa/prod）。本机直连共享 infra 示例：
# OBS_ENABLED=true
# OBS_KAFKA_SERVERS=localhost:39092
# OBS_KAFKA_TOPIC=dev.obs.agent.contract-check
# OBS_KAFKA_SASL_USERNAME=
# OBS_KAFKA_SASL_PASSWORD=
# OBS_FLUSH_BATCH=500
# OBS_FLUSH_INTERVAL_S=2.0
# 上报数据里的 agent 版本，消费方按 agent 名 + 版本区分同一次发布的产物；随发布更新
# AGENT_VERSION=0.1.0
